# ==============================================================================
# HTCondor Submit File: SND@LHC Event Prefiltering (Single Partition per Job)
#
# Process per partition:
#   Inputs : /eos/experiment/sndlhc/convertedData/physics/2023/run_006596/sndsw_raw-%s.root
#   Outputs: /eos/user/i/idioniso/snd-numu-charm/prefiltered/2023/b2nob1Muons/run006596/sndsw_raw-%s.root
#
# Usage:
#   condor_submit prefilter.sub
#   ./submit_prefilter.sh
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/prefilter
initialdir              = $(base_dir)

flavour                 = $(flavour:microcentury)
args_file               = $(args_file:$(base_dir)/args_run6596_287.txt)

input_pattern           = $(input_pattern:/eos/experiment/sndlhc/convertedData/physics/2023/run_006596/sndsw_raw-%s.root)
output_pattern          = $(output_pattern:/eos/user/i/idioniso/snd-numu-charm/prefiltered/2023/b2nob1Muons/run006596/sndsw_raw-%s.root)
cutset                  = $(cutset:b2nob1Muons)

executable              = $(base_dir)/run_prefilter_partition.sh
arguments               = $(partition) $(input_pattern) $(output_pattern) $(cutset)
environment             = "FORCE=$(force:0)"

output                  = $(base_dir)/out/prefilter_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/prefilter_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/prefilter_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB
max_retries             = 2

queue partition from $(args_file)
