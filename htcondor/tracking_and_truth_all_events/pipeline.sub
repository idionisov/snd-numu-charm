# ==============================================================================
# HTCondor Submit File: SND@LHC Chained Pipeline (All Events)
# Tracking (All Events) -> MCTruth Extraction -> 2D Event Displays
#
# Usage:
#   condor_submit htcondor/tracking_and_truth_all_events/pipeline.sub
#   condor_submit htcondor/tracking_and_truth_all_events/pipeline.sub flavour=workday
#   condor_submit htcondor/tracking_and_truth_all_events/pipeline.sub args_file=path/to/custom_partitions.txt
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/tracking_and_truth_all_events
initialdir              = $(base_dir)

executable              = $(base_dir)/run_pipeline_partition.sh
arguments               = $(partition) $(input_pattern) $(track_pattern) $(truth_pattern) $(disp_pattern) all
environment             = "FORCE=1 ALL_EVENTS=1"

flavour                 = $(flavour:longlunch)
default_args            = $(base_dir)/args_nu14_volTarget_1000.txt
args_file               = $(args_file:$(default_args))

input_pattern           = $(input_pattern:/eos/experiment/sndlhc/MonteCarlo/Neutrinos/Genie/2mmRangeCut/sndlhc_15000fb-1_2022_down/nu14/volume_volTarget/%s/sndLHC.Genie-TGeant4_dig.root)
track_pattern           = $(track_pattern:/eos/user/i/idioniso/snd-numu-charm/data/sndlhc_15000fb-1_2022_down_nu14_volume_volTarget/%s/sndLHC.Genie-TGeant4_dig_2MuTrks.root)
truth_pattern           = $(truth_pattern:/eos/user/i/idioniso/snd-numu-charm/data/sndlhc_15000fb-1_2022_down_nu14_volume_volTarget/%s/sndLHC.Genie-TGeant4_dig_2MuTrks_truth.root)
disp_pattern            = $(disp_pattern:/eos/user/i/idioniso/snd-numu-charm/event_displays/sndlhc_15000fb-1_2022_down_nu14_volume_volTarget/partitions/displays_part%s.root)

output                  = $(base_dir)/out/pipeline_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/pipeline_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/pipeline_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

# CERN Job Flavours:
#   microcentury : 1 hour
#   longlunch    : 2 hours (default - recommended for combined tracking + truth + displays)
#   workday      : 8 hours
+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh

request_cpus            = 1
request_memory          = 4GB
max_retries             = 2

queue partition from $(args_file)
