# ==============================================================================
# HTCondor Submit File: SND@LHC MCTruth Neutrino Event Categorization
#
# Usage:
#   condor_submit htcondor/mctruth_neutrinos/mctruth_neutrinos.sub
#   condor_submit htcondor/mctruth_neutrinos/mctruth_neutrinos.sub flavour=workday
#   condor_submit htcondor/mctruth_neutrinos/mctruth_neutrinos.sub args_file=path/to/custom_partitions.txt
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/mctruth_neutrinos
initialdir              = $(base_dir)

executable              = $(base_dir)/run_mctruth_partition.sh
arguments               = $(partition)

flavour                 = $(flavour:longlunch)
default_args            = $(base_dir)/args_partitions.txt
args_file               = $(args_file:$(default_args))

output                  = $(base_dir)/out/mctruth_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/mctruth_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/mctruth_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

# CERN Job Flavours:
#   espresso     : 20 min
#   microcentury : 1 hour
#   longlunch    : 2 hours (default - recommended for ~20-25m partition runs)
#   workday      : 8 hours
+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh

request_cpus            = 1
request_memory          = 4GB
max_retries             = 2

queue partition from $(args_file)
