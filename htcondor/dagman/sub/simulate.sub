# ==============================================================================
# HTCondor Submit File: DAGMan Single Job - Stage 1 (Simulation)
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/simulate
dag_dir                 = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/dagman
initialdir              = $(dag_dir)

flavour                 = $(flavour:workday)
src_pattern             = $(src_pattern:/eos/experiment/sndlhc/MonteCarlo/Neutrinos/Genie/2mmRangeCut/sndlhc_15000fb-1_2022_down/nu14/volume_volTarget/%s)
dest_pattern            = $(dest_pattern:/eos/user/i/idioniso/snd-numu-charm/data/newP8/%s)

executable              = $(base_dir)/run_simulate_partition.sh
arguments               = $(partition) $(src_pattern) $(dest_pattern)
environment             = "FORCE=$(force:0) NEVENTS=$(nevents:1000)"

output                  = $(dag_dir)/out/sim_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(dag_dir)/err/sim_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(dag_dir)/log/dag_jobs.log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 4GB
request_disk            = 4GB

queue 1
