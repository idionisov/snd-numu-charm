# ==============================================================================
# HTCondor Submit File: SND@LHC Chained Pipeline (newP8 MCEB All Events)
# Tracking (All Events) -> MCTruth Extraction -> Charm Skims -> 2D Event Displays
#
# Usage:
#   condor_submit pipeline_newP8_mceb.sub
#   ./submit_newP8_MCEB.sh
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/tracking_and_truth_all_events
initialdir              = $(base_dir)

flavour                 ?= longlunch
args_file               ?= $(base_dir)/args_nu14_volTarget_1000.txt

# Default MCEB Path Patterns for newP8 (can be overridden via condor_submit CLI)
input_pattern           ?= /eos/user/i/idioniso/snd-numu-charm/data/newP8/%s/sndLHC.Genie-TGeant4_MCEB_dig.root
track_pattern           ?= /eos/user/i/idioniso/snd-numu-charm/data/newP8/%s/sndLHC.Genie-TGeant4_MCEB_dig_2MuTrks.root
truth_pattern           ?= /eos/user/i/idioniso/snd-numu-charm/data/newP8/%s/sndLHC.Genie-TGeant4_MCEB_dig_2MuTrks_truth.root
disp_pattern            ?= /eos/user/i/idioniso/snd-numu-charm/event_displays/newP8_MCEB/partitions/displays_part%s.root
truth_source            ?= /eos/user/i/idioniso/snd-numu-charm/data/newP8/%s/sndLHC.Genie-TGeant4_dig.root
env_vars                ?= FORCE=1 ALL_EVENTS=1 SND_CHANNELS_READONLY=1

executable              = $(base_dir)/run_pipeline_partition_newP8.sh
arguments               = $(partition) $(input_pattern) $(track_pattern) $(truth_pattern) $(disp_pattern) all $(truth_source)
environment             = "$(env_vars)"

output                  = $(base_dir)/out/pipeline_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/pipeline_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/pipeline_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 2GB
max_retries             = 3

queue partition from $(args_file)
