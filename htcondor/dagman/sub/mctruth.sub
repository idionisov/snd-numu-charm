# ==============================================================================
# HTCondor Submit File: DAGMan Single Job - Stage 3 (MCTruth Extraction & Branch Transplant)
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/mctruth
dag_dir                 = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/dagman
initialdir              = $(dag_dir)

flavour                 = $(flavour:espresso)
data_pattern            = $(data_pattern:/eos/user/i/idioniso/snd-numu-charm/data/newP8/%s)
truth_pattern           = $(truth_pattern:/eos/user/i/idioniso/snd-numu-charm/data/newP8/%s/sndLHC.Genie-TGeant4.root)
mceb_pattern            = $(mceb_pattern:/eos/user/i/idioniso/snd-numu-charm/data/newP8/%s/sndLHC.Genie-TGeant4_MCEB.root)
output_pattern          = $(output_pattern:$(mceb_pattern))

executable              = $(base_dir)/run_mctruth_partition.sh
arguments               = $(partition) $(truth_pattern) $(mceb_pattern) $(output_pattern)
environment             = "FORCE=$(force:0)"

output                  = $(dag_dir)/out/mctruth_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(dag_dir)/err/mctruth_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(dag_dir)/log/dag_jobs.log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 2GB
request_disk            = 2GB

queue 1
