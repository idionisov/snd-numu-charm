# ==============================================================================
# HTCondor Submit File: SND@LHC ILP Track Reconstruction & Feature Extraction
# Injects "ilp" TTree with data-level reconstruction observables per partition
#
# Usage:
#   condor_submit htcondor/ilp_features/ilp.sub
#   condor_submit htcondor/ilp_features/ilp.sub flavour=workday
#   condor_submit htcondor/ilp_features/ilp.sub args_file=path/to/custom_partitions.txt
# ==============================================================================

base_dir                = /afs/cern.ch/work/i/idioniso/snd-numu-charm/htcondor/ilp_features
initialdir              = $(base_dir)

executable              = $(base_dir)/run_ilp_partition.sh
arguments               = $(partition) $(input_pattern)

flavour                 = $(flavour:workday)
args_file               = $(args_file:$(base_dir)/args_nu14_volTarget_1000.txt)

input_pattern           = /eos/user/i/idioniso/snd-numu-charm/data/sndlhc_15000fb-1_2022_down_nu14_volume_volTarget/%s/sndLHC.Genie-TGeant4_dig_2MuTrks_truth.root

output                  = $(base_dir)/out/ilp_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = $(base_dir)/err/ilp_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = $(base_dir)/log/ilp_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

# CERN Job Flavours:
#   espresso     : 20 minutes
#   microcentury : 1 hour
#   longlunch    : 2 hours
#   workday      : 8 hours (default)
#   tomorrow     : 1 day
+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"
MY.JobRequiresAFS       = True

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = $(base_dir)/sndswEnv.sh, /afs/cern.ch/user/i/idioniso/ddfUtils

request_cpus            = 1
request_memory          = 4GB
max_retries             = 3

queue partition from $(args_file)
