# ==============================================================================
# HTCondor Submit File: SND@LHC Downstream Dimuon Tracking (run_dimuon_reco.py)
#
# Usage:
#   condor_submit htcondor/tracking/tracking.sub
#   condor_submit htcondor/tracking/tracking.sub flavour=workday
#   condor_submit htcondor/tracking/tracking.sub args_file=htcondor/tracking/args_partitions.txt
#   condor_submit htcondor/tracking/tracking.sub input_pattern="..." output_pattern="..."
# ==============================================================================

executable              = run_tracking_partition.sh
arguments               = $(partition) $(input_pattern) $(output_pattern)

flavour                 = $(flavour:microcentury)
args_file               = $(args_file:args_partitions.txt)

input_pattern           = $(input_pattern:/eos/experiment/sndlhc/MonteCarlo/Neutrinos/Genie/sndlhc_13TeV_down_volTarget_100fb-1_SNDG18_02a_01_000/%s/sndLHC.Genie-TGeant4_digCPP.root)
output_pattern          = $(output_pattern:/eos/user/i/idioniso/snd-numu-charm/data/%s/sndLHC.Genie-TGeant4_digCPP_dimuonReco.root)

output                  = out/tracking_part$(partition)_$(ClusterId)_$(ProcId).out
error                   = err/tracking_part$(partition)_$(ClusterId)_$(ProcId).err
log                     = log/tracking_$(ClusterId).log

getenv                  = False
notification            = Never
requirements            = (OpSysAndVer =?= "AlmaLinux9")

# CERN Job Flavours:
#   espresso     : 20 min
#   microcentury : 1 hour (default - dimuon tracking takes ~1-3 min per partition)
#   longlunch    : 2 hours
#   workday      : 8 hours
+JobFlavour             = "$(flavour)"
+AccountingGroup        = "group_u_SNDLHC.users"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = sndswEnv.sh

request_cpus            = 1
request_memory          = 4GB
max_retries             = 2

queue partition from $(args_file)
