# ==============================================================================
# HTCondor DAGMan Configuration for SND@LHC Simulation & Reconstruction Pipeline
# ==============================================================================

# Maximum total jobs actively submitted/running across the entire DAG at any time
DAGMAN_MAX_JOBS_SUBMITTED       = 300

# Maximum idle jobs waiting in queue
DAGMAN_MAX_JOBS_IDLE            = 100

# Rate limiter for condor_submit bursts (prevents schedd spikes)
DAGMAN_MAX_SUBMITS_PER_INTERVAL = 25

# Interval (in seconds) between scans of the user log file
DAGMAN_USER_LOG_SCAN_INTERVAL   = 5

# Auto-recovery behavior
DAGMAN_RETRY_SUBMIT_FIRST       = True
DAGMAN_RETRY_GENERATE_SUBDAGS   = True
